FROM node:20-alpine

WORKDIR /workspace

# Copy pre-built packages
COPY packages ./packages

# Copy and setup frontend
WORKDIR /workspace/OMS/frontend
COPY OMS/frontend/package.json ./

# Adjust package.json for Docker paths
RUN sed -i 's|"file:../../packages|"file:/workspace/packages|g' package.json

RUN npm install

# Copy frontend source
COPY OMS/frontend .

ENV DOCKER_ENV=true

EXPOSE 3001

CMD ["npm", "run", "dev"]
