FROM node:20-alpine

RUN apk add --no-cache git

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

ENV DOCKER_ENV=true

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_OMS_API_URL
ARG NEXT_PUBLIC_WMS_API_URL
ARG NEXT_PUBLIC_IDENTITY_URL

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_OMS_API_URL=$NEXT_PUBLIC_OMS_API_URL
ENV NEXT_PUBLIC_WMS_API_URL=$NEXT_PUBLIC_WMS_API_URL
ENV NEXT_PUBLIC_IDENTITY_URL=$NEXT_PUBLIC_IDENTITY_URL

RUN npm run build

EXPOSE 3001

CMD ["npm", "start"]
