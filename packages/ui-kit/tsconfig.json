{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@types/*": [
        "../../PMI/frontend/node_modules/@types/*",
        "../../OMS/frontend/node_modules/@types/*"
      ],
      "*": [
        "../../PMI/frontend/node_modules/*",
        "../../OMS/frontend/node_modules/*",
        "./node_modules/*"
      ]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["src/__tests__/**", "src/test/**"]
}
